# ID público do cliente OAuth Web criado no Google Cloud Console.
# Não é um segredo e será incluído no bundle da aplicação.
VITE_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Chave de API (Google Cloud Console > Credenciais > Chave de API), restrita
# à Google Picker API. Opcional: só é necessária para permitir ligar um
# dispositivo a uma folha de relatório já criada noutro dispositivo.
VITE_GOOGLE_API_KEY=
